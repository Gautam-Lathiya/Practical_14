@model IEnumerable<Practical_14.Employee>

<input type="text" id="searchBox" placeholder="Search by name..." class="form-control mb-3" />

<div id="employeeTable">
    @Html.Partial("_EmployeeList", Model)
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $('#searchBox').on('keyup', function () {
            var term = $(this).val();

            $.ajax({
                url: '@Url.Action("Search", "Employees")',
                data: { term: term },
                success: function (result) {
                    $('#employeeTable').html(result);
                }
            });
        });
    </script>
}
