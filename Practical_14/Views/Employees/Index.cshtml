@model PagedList.IPagedList<Practical_14.Employee>
@using PagedList.Mvc

<a href="@Url.Action("Create", "Employees")" class="btn btn-primary mb-3">Create New Employee</a>

<div class="input-group mb-3">
    <input type="text" id="searchBox" placeholder="Search by name..." class="form-control" />
    <div class="input-group-append">
        <button id="searchBtn" class="btn btn-outline-secondary" type="button">Search</button>
    </div>
</div>

<div id="employeeTable">
    @Html.Partial("_EmployeeList", Model)
</div>

@Html.PagedListPager(Model, page => Url.Action("Index", new { page, term = ViewData["searchTerm"] }))

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $('#searchBtn').on('click', function () {
            var term = $('#searchBox').val();

            $.ajax({
                url: '@Url.Action("Search", "Employees")',
                data: { term: term, page: 1 },
                success: function (result) {
                    $('#employeeTable').html(result);
                }
            });
        });
    </script>
}
